# ---- Frontend (Vite) ----
# Base URL of the backend API (no trailing slash).
# - Local dev: leave EMPTY — the Vite dev proxy forwards /api to localhost:8787
# - Production (Vercel): set to your API server, e.g. https://api.yourdomain.com
VITE_API_URL=

# ---- Backend (only used when running the API from this repo via `npm run api` / `npm run dev:all`) ----
# See crossborders-api/.env.example for the full list of server variables.
PORT=8787
APP_DOMAIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/logistics_db?retryWrites=true&w=majority
BREVO_API_KEY=
MAIL_FROM=no-reply@crossbordersdeliveries.com
