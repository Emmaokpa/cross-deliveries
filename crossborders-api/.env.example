[TEMPLATE]
# ---- Server ----
PORT=8787

# Public URL of the frontend (used in tracking links inside emails/PDFs)
APP_DOMAIN=http://localhost:5173

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string

# ---- PocketBase (self-hosted database) ----
# URL of your PocketBase instance (local: http://127.0.0.1:8090,
# on your VPS behind Coolify/Docker: http://pocketbase:8090 or https://pb.yourdomain.com)
POCKETBASE_URL=http://127.0.0.1:8090
# Superuser credentials — the API uses them to create collections and read/write
# records. Create one with `./pocketbase superuser upsert <email> <password>`.
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# ---- One-time MongoDB → PocketBase migration (npm run migrate:mongodb) ----
# Only needed until you have imported your Atlas data; safe to delete afterwards.
MONGODB_URI=

# ---- Brevo SMTP (transactional email; leave SMTP_USER empty to simulate emails in logs) ----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@crossbordersdeliveries.com
