# ---- Server ----
PORT=8787

# Public URL of the frontend (used in tracking links inside emails/PDFs)
APP_DOMAIN=http://localhost:5173

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string

# ---- MongoDB (Atlas connection string) ----
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/logistics_db?retryWrites=true&w=majority

# ---- Brevo SMTP (transactional email; leave SMTP_USER empty to simulate emails in logs) ----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@crossbordersdeliveries.com
