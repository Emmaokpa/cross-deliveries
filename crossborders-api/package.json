{
  "name": "crossborders-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CrossBordersDeliveries API — Express + PocketBase backend (auth, shipments, tracking, invoices, audit)",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "migrate:mongodb": "node --env-file-if-exists=.env scripts/migrate-from-mongodb.mjs",
    "schema:export": "node --env-file-if-exists=.env scripts/schema.mjs export",
    "schema:push": "node --env-file-if-exists=.env scripts/schema.mjs push",
    "schema:verify": "node --env-file-if-exists=.env scripts/schema.mjs verify"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.11",
    "pdfkit": "^0.20.2",
    "pocketbase": "^0.28.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "mongodb": "^7.7.0"
  }
}
